# Local persistent Chroma database. This directory is generated at runtime.
CHROMA_PERSIST_PATH=data/chroma
RUNTIME_DB_PATH=data/runtime.sqlite3

# LiteLLM gateway in OpenAI-compatible mode. Configure the gateway to route
# this embedding model to Mistral. For this local configuration, use the same
# value as LITELLM_MASTER_KEY below.
LITELLM_API_BASE=http://127.0.0.1:4000/v1
LITELLM_API_KEY=replace-with-litellm-master-key
LITELLM_EMBEDDING_MODEL=mistral-embed
# The bounded explanation agent calls this OpenAI-compatible LiteLLM route.
LITELLM_CHAT_MODEL=mistral-agent
# The live pipeline publishes a safe deterministic assessment first. This
# bounds only the background Mistral refinement request.
LITELLM_AGENT_TIMEOUT_SECONDS=8
# Continuous healthy time required before the active incident and its evidence
# clear from Flow Warden. Retrieval must also have finished.
AGENT_RECOVERY_STABILITY_SECONDS=8
LITELLM_TIMEOUT_SECONDS=30

# Used by the LiteLLM gateway process, not by this application process.
MISTRAL_API_KEY=replace-with-mistral-api-key
LITELLM_MASTER_KEY=replace-with-litellm-master-key

# Optional SigNoz/OpenTelemetry traces. Self-hosted SigNoz on this machine:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=iot-anomaly-control
OTEL_SERVICE_VERSION=0.1.0
OTEL_SERVICE_NAMESPACE=water-treatment
OTEL_DEPLOYMENT_ENVIRONMENT=development
# Export custom metrics promptly enough for a local demo dashboard.
OTEL_METRIC_EXPORT_INTERVAL=5000
